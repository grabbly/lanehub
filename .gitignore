__pycache__/
*.pyc
.venv/
venv/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.pytest_cache/
.DS_Store

# Watcher config carries lane API keys — keep the real one out of git.
watch.config.json

# Keep docs/ tracked. A global excludes file may carry a `/Docs/*` rule, and on
# a case-insensitive filesystem (macOS default, core.ignorecase=true) it silently
# swallows this repo's docs/ — the whole folder then never reaches the remote.
# A repo .gitignore outranks core.excludesFile, so this re-includes it.
!/docs/
!/docs/**
