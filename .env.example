# --- required -------------------------------------------------------------

# Password for the /admin web UI. Generate e.g.: openssl rand -base64 18
HUB_ADMIN_PASSWORD=change-me

# --- webhook vs polling ----------------------------------------------------

# Public HTTPS origin of this hub, e.g. https://hub.example.com
# Set  → webhook mode (Telegram pushes updates, near-realtime).
# Empty → polling mode (works without a domain / behind NAT; ~2s lag).
HUB_PUBLIC_BASE_URL=

# Force a mode explicitly: webhook | polling | off
#HUB_DELIVERY_MODE=

# --- optional ---------------------------------------------------------------

# Host port docker publishes on 127.0.0.1 (change if 8080 is already taken):
#HUB_PORT=8080

#HUB_POLL_INTERVAL=2

# Earlier public origins of this hub, comma-separated (after a domain move).
# A webhook Telegram still sends there is moved to HUB_PUBLIC_BASE_URL; any
# other address is treated as another system and never taken over silently.
#HUB_PREVIOUS_BASE_URLS=https://old-hub.example.com

# Webhook watchdog: seconds between checks of where each bot's updates go
# (0 = off). Raises an alarm if another system took a bot's webhook.
#HUB_WEBHOOK_CHECK_INTERVAL=300

# @mentions older than this many hours don't wake the agent (0 = no limit).
#HUB_WAKE_MAX_AGE_HOURS=24

# Boards: a task board per chat with a read-only client page (docs/BOARDS.md).
#HUB_BOARDS=1

# Speech-to-text: transcribe voice/audio/video-note messages via a Whisper service.
#   OpenAI:      HUB_STT_URL=https://api.openai.com/v1/audio/transcriptions + HUB_STT_MODEL=whisper-1
#   Self-hosted: any Whisper server taking multipart `file` and answering {"text": ...}
#HUB_STT_URL=https://stt.example.com/v1/audio/transcriptions
#HUB_STT_KEY=
# Header for the key: Authorization (Bearer, default) or e.g. X-API-Key
#HUB_STT_KEY_HEADER=Authorization
#HUB_STT_MODEL=
#HUB_STT_LANGUAGE=
#HUB_STT_MAX_SECONDS=900
#HUB_STT_TIMEOUT=600

#HUB_DB_PATH=/data/hub.db
#HUB_TELEGRAM_API=https://api.telegram.org
