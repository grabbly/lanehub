{
  "poll_interval": 5,
  "claude_bin": "claude",
  "lanes": [
    {
      "base": "https://hub.example.com/backend",
      "key_env": "LANEHUB_KEY_BACKEND",
      "project_dir": "/srv/projects/backend",
      "extra_args": ["--permission-mode", "acceptEdits"]
